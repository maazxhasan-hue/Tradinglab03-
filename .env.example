# Local development only. Never commit real secrets.
# For GitHub Actions, add GEMINI_API_KEY (or OPENAI_API_KEY) under Settings > Secrets and variables > Actions.
# The autonomous client execution workflow defaults AI_PROVIDER to gemini; set the repository variable to override it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Choose one provider: template (offline), openai, or gemini.
AI_PROVIDER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# The AI worker only creates drafts. It cannot publish, contact clients, or spend money.
