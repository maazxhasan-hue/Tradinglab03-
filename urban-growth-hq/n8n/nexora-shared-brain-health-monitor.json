{
  "id": "nexoraSharedBrainHealthMonitor01",
  "name": "Nexora - Shared Brain Service Health Monitor",
  "active": false,
  "nodes": [
    {
      "id": "nexora-health-schedule",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "check-hq-health",
      "name": "Check HQ Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        -240
      ],
      "parameters": {
        "method": "GET",
        "url": "https://nexora-hq-secure.onrender.com/healthz",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "check-harvey-health",
      "name": "Check Harvey Health and Shared Brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        -80
      ],
      "parameters": {
        "method": "GET",
        "url": "https://nexora-harvey-worker.onrender.com/public-status",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "check-tradinglab-health",
      "name": "Check TradingLab03 Health and Shared Brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        80
      ],
      "parameters": {
        "method": "GET",
        "url": "https://tradinglab03.onrender.com/public-status",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "check-n8n-health",
      "name": "Check n8n Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "https://urban-growth-n8n.onrender.com/healthz",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Check HQ Health",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check Harvey Health and Shared Brain",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check TradingLab03 Health and Shared Brain",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check n8n Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  }
}
